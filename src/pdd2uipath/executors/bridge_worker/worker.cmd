@echo off
rem pdd2uipath bridge worker (cmd.exe). Generated by `pdd2uipath bridge install`.
rem Uses only cmd.exe builtins (plus find/findstr) so it runs where PowerShell is blocked.
rem Reads jobs\<id>.args (one field per line: cwd=, timeout=, arg=...), executes allowlisted
rem `uip` verbs with cwd inside the workspace root, writes results\<id>.json atomically
rem (write .tmp then move) and touches heartbeat.json every loop. Stop with Ctrl+C or STOP file.
rem Validation here is reduced (verb allowlist, cwd boundary, metacharacters); the Python side
rem and worker.ps1 validate every path flag. Timeouts are not enforced by this variant.
setlocal EnableExtensions DisableDelayedExpansion
set "ROOT=%~dp0"
set "ROOT=%ROOT:~0,-1%"
set "WORKSPACE=__WORKSPACE_ROOT__"
set "UIP_EXE=__UIP_EXE__"
set "UIP_PRE=__UIP_PRE__"
set "POLL_S=__POLL_S__"
set "JOBS=%ROOT%\jobs"
set "RESULTS=%ROOT%\results"
if not exist "%JOBS%" mkdir "%JOBS%"
if not exist "%RESULTS%" mkdir "%RESULTS%"
echo pdd2uipath bridge worker (cmd.exe)
echo   workspace : %WORKSPACE%
echo   bridge    : %ROOT%
echo   uip       : %UIP_EXE% %UIP_PRE%
echo   allowlist : rpa templates/init/restore/packages/activities/validate/build/analyze/analyzer-rules/studio/instances/get-object-repository/workflow-examples, login status/which, --version
echo Press Ctrl+C to stop (or create %ROOT%\STOP).
call :heartbeat

:loop
if exist "%ROOT%\STOP" (
  echo STOP file found, exiting.
  del /q "%ROOT%\STOP" >nul 2>&1
  goto :eof
)
for /f "delims=" %%F in ('dir /b /a-d /o:d "%JOBS%\*.json" 2^>nul') do call :job "%%~nF"
call :heartbeat
timeout /t %POLL_S% /nobreak >nul 2>&1 || ping -n 2 127.0.0.1 >nul
goto :loop

:heartbeat
> "%ROOT%\heartbeat.json.tmp" echo {"worker":"cmd","ts":"%DATE% %TIME%","root":"%WORKSPACE:\=\\%"}
move /y "%ROOT%\heartbeat.json.tmp" "%ROOT%\heartbeat.json" >nul 2>&1
goto :eof

:job
set "ID=%~1"
set "REJECT="
if not exist "%JOBS%\%ID%.args" (
  set "REJECT=malformed job: missing %ID%.args sidecar"
  goto :finish
)
rem metacharacter checks run with delayed expansion OFF so ! and " are literal here
findstr /r /c:"[&|<>^%%]" "%JOBS%\%ID%.args" >nul 2>&1 && set "REJECT=token contains forbidden characters"
if defined REJECT goto :finish
find "!" "%JOBS%\%ID%.args" >nul 2>&1 && set "REJECT=token contains forbidden characters"
if defined REJECT goto :finish
find """" "%JOBS%\%ID%.args" >nul 2>&1 && set "REJECT=token contains forbidden characters"
if defined REJECT goto :finish
setlocal EnableDelayedExpansion
set "ARGS="
set "CWD="
set "N=0"
set "V1="
set "V2="
for /f "usebackq delims=" %%L in ("%JOBS%\%ID%.args") do (
  set "LINE=%%L"
  if "!LINE:~0,4!"=="cwd=" set "CWD=!LINE:~4!"
  if "!LINE:~0,4!"=="arg=" (
    set /a N+=1
    if !N!==1 set "V1=!LINE:~4!"
    if !N!==2 set "V2=!LINE:~4!"
    set "ARGS=!ARGS! "!LINE:~4!""
  )
)
if "!V1!"=="" set "REJECT=empty argv" & goto :finish
if /i "!V1!"=="--version" goto :checkcwd
if /i "!V1!"=="--help" goto :checkcwd
if /i "!V1!"=="login" (
  if /i "!V2!"=="status" goto :checkcwd
  if /i "!V2!"=="which" goto :checkcwd
  set "REJECT=uip login !V2! is not allowlisted"
  goto :finish
)
if /i not "!V1!"=="rpa" set "REJECT=uip !V1! is not allowlisted" & goto :finish
set "OK="
for %%A in (templates init restore packages activities validate build analyze analyzer-rules studio instances get-object-repository workflow-examples) do if /i "!V2!"=="%%A" set "OK=1"
if not defined OK set "REJECT=uip rpa !V2! is not allowlisted" & goto :finish
:checkcwd
set "WS=!WORKSPACE!"
set "CWDL=!CWD!"
call :lower WS
call :lower CWDL
if "!CWDL!"=="!WS!" goto :run
call :startswith "!CWDL!" "!WS!\"
if not "!STARTS!"=="1" set "REJECT=cwd !CWD! is outside the workspace root" & goto :finish
:run
if not exist "!CWD!\" set "REJECT=cwd !CWD! does not exist" & goto :finish
echo [%ID%] uip!ARGS!
pushd "!CWD!"
if /i "%UIP_EXE:~-4%"==".cmd" (
  call "%UIP_EXE%" %UIP_PRE%!ARGS! > "%RESULTS%\%ID%.out" 2> "%RESULTS%\%ID%.err"
) else (
  "%UIP_EXE%" %UIP_PRE%!ARGS! > "%RESULTS%\%ID%.out" 2> "%RESULTS%\%ID%.err"
)
set "EC=!ERRORLEVEL!"
popd
echo [%ID%] exit !EC!
> "%RESULTS%\%ID%.json.tmp" echo {"schema":"pdd2uipath.bridge.result/1","id":"%ID%","status":"ok","exit_code":!EC!,"stdout_file":"%ID%.out","stderr_file":"%ID%.err","worker":"cmd","started":"","finished":"%DATE% %TIME%","reason":""}
move /y "%RESULTS%\%ID%.json.tmp" "%RESULTS%\%ID%.json" >nul
del /q "%JOBS%\%ID%.json" "%JOBS%\%ID%.args" >nul 2>&1
goto :eof

:finish
echo [%ID%] REJECTED: %REJECT%
set "REJ=%REJECT:\=/%"
> "%RESULTS%\%ID%.json.tmp" echo {"schema":"pdd2uipath.bridge.result/1","id":"%ID%","status":"rejected","exit_code":126,"stdout_file":"","stderr_file":"","worker":"cmd","started":"","finished":"%DATE% %TIME%","reason":"%REJ%"}
move /y "%RESULTS%\%ID%.json.tmp" "%RESULTS%\%ID%.json" >nul
del /q "%JOBS%\%ID%.json" "%JOBS%\%ID%.args" >nul 2>&1
goto :eof

:lower
rem lowercase the variable named %1 (ASCII; the search side of :a=a is case-insensitive)
for %%C in (a b c d e f g h i j k l m n o p q r s t u v w x y z) do set "%1=!%1:%%C=%%C!"
goto :eof

:startswith
rem sets STARTS=1 when %1 starts with %2
set "S1=%~1"
set "S2=%~2"
set "STARTS=0"
call set "TAIL=%%S1:*%S2%=%%"
if "!TAIL!"=="!S1!" goto :eof
if "!S2!!TAIL!"=="!S1!" set "STARTS=1"
goto :eof
